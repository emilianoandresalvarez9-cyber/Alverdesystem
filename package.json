{
  "name": "alverde-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "local": "node scripts/local-dev.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "qa:guard": "node scripts/qa-guard.mjs",
    "test:db:nodocker": "bash qa/pg-harness/run.sh .",
    "verify": "npm run qa:guard && npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "gen:types": "python3 -I qa/pg-harness/gen_types.py > src/shared/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.4.1",
    "dotenv": "^18.0.3",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "20.14.5",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-window": "^7.4.1"
  }
}
